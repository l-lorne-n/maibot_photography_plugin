+def _normalize_embedding_image_arg(args: Dict[str, Any]) -> Tuple[bytes, str, str] | None:
+    """校验单图嵌入输入；图片字节与文本输入互斥，解码工作由线程池执行。"""
+    encoded = args.get("image_base64")
+    if encoded is None:
+        return None
+    if any(args.get(key) is not None for key in ("text", "texts", "input", "inputs")):
+        raise ValueError("image_base64 与 text/texts/input/inputs 只能提供一种输入")
+    if not isinstance(encoded, str) or not encoded.strip():
+        raise ValueError("image_base64 必须为非空 Base64 字符串")
+    encoded = encoded.strip()
+    mime_type = args.get("mime_type", "")
+    if not isinstance(mime_type, str):
+        raise ValueError("mime_type 必须为字符串")
+    mime_type = mime_type.strip().lower()
+    if encoded.startswith("data:"):
+        header, separator, encoded = encoded.partition(",")
+        if not separator or not header.endswith(";base64"):
+            raise ValueError("图片 Data URI 必须使用 Base64 编码")
+        declared_mime = header[5:-7].lower()
+        if mime_type and mime_type != declared_mime:
+            raise ValueError("mime_type 与图片 Data URI 声明不一致")
+        mime_type = declared_mime
+    if re.fullmatch(r"image/[a-z0-9.+-]+", mime_type) is None:
+        raise ValueError("图片嵌入需要有效的 image/* MIME 类型")
+    preprocess_version = args.get("preprocess_version")
+    if not isinstance(preprocess_version, str) or not 1 <= len(preprocess_version.strip()) <= 128:
+        raise ValueError("preprocess_version 必须为 1–128 字符的预处理版本")
+    max_bytes = 2 * 1024 * 1024
+    if len(encoded) > ((max_bytes + 2) // 3) * 4:
+        raise ValueError("图片嵌入输入超过 2 MiB")
+    try:
+        data = base64.b64decode(encoded, validate=True)
+    except (ValueError, base64.binascii.Error) as exc:
+        raise ValueError("image_base64 不是有效的 Base64 编码") from exc
+    if not data or len(data) > max_bytes:
+        raise ValueError("图片嵌入输入必须为 1 字节至 2 MiB")
+    return data, mime_type, preprocess_version.strip()
 
 
